	"license": "MIT",
	"bugs": {
		"url": "https://github.com/hametuha/wpametu/issues"
	},
	"engines": {
		"node": ">=24.22.1"
	},
	"homepage": "https://github.com/hametuha/wpametu",
	"devDependencies": {
		"@babel/core": "^8.0.7",
		"@babel/eslint-parser": "^8.0.7",
		"@babel/plugin-transform-react-jsx": "^8.0.1",
		"@babel/preset-env": "^8.0.7",
		"@kunoichi/grab-deps": "^3.3.0",
		"@wordpress/env": "^11.17.0",
		"@wordpress/eslint-plugin": "^27.1.0",
		"babel-loader": "^10.1.1",
		"babel-preset-minify": "^0.5.1",
		"eslint": "^10.13.0",
		"font-awesome": "^4.7",
		"gulp": "^5.0",
		"gulp-autoprefixer": "^10.0.0",
		"gulp-eslint": "^6.0.0",
		"gulp-imagemin": "9.2",
		"gulp-load-plugins": "^2.0",
		"gulp-notify": "^5.0.0",
		"gulp-plumber": "^1.0",
		"gulp-rename": "^2.0.0",
		"gulp-sass": "^6.0",
		"gulp-sourcemaps": "^3.0",
		"gulp-stylelint": "^13.0.0",
		"imagemin-pngquant": "^10.0",
		"jquery-ui": "^1.12",
